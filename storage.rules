rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Las imágenes del portafolio son públicas; solo el administrador sube.
    match /portafolio/{archivo=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
